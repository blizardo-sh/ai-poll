{
  "rules": {
    ".read": false,
    ".write": false,
    "lesson1": {
      "teacherEmail": {
        ".read": false,
        ".write": false
      },
      "teacherAccess": {
        ".read": false,
        ".write": false
      },
      "explanations": {
        ".read": "auth != null",
        ".write": false
      },
      "catalog": {
        ".read": "auth != null",
        ".write": false
      },
      "rooms": {
        "$room": {
          "state": {
            ".read": "auth != null",
            ".write": "auth != null && newData.exists()",
            ".validate": "newData.hasChildren(['question','phase','round','session','prompt']) && root.child('lesson1/catalog/'+newData.child('question').val()).exists()",
            "question": {
              ".validate": "newData.isString()"
            },
            "phase": {
              ".validate": "newData.val() === 'idle' || newData.val() === 'open' || newData.val() === 'closed' || newData.val() === 'results' || newData.val() === 'explanation'"
            },
            "round": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-zA-Z0-9_-]{1,80}$/)"
            },
            "session": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "prompt": {
              ".validate": "newData.isString() && newData.val().length <= 4000"
            },
            "$other": {
              ".validate": false
            }
          },
          "votes": {
            "$round": {
              ".read": "auth != null && root.child('lesson1/rooms/'+$room+'/state').child('round').val() === $round",
              "$uid": {
                ".read": "auth != null && auth.uid === $uid",
                ".write": "auth != null && auth.uid === $uid && root.child('lesson1/rooms/'+$room+'/state').child('round').val() === $round && root.child('lesson1/rooms/'+$room+'/state').child('phase').val() === 'open' && newData.exists()",
                ".validate": "newData.isNumber() && root.child('lesson1/catalog/'+root.child('lesson1/rooms/'+$room+'/state').child('question').val()+'/options/'+newData.val()).exists()"
              }
            }
          },
          "stats": {
            ".read": false,
            ".write": false
          },
          "results": {
            ".read": false,
            ".write": false
          },
          "revealed": {
            "$round": {
              ".read": "auth != null && root.child('lesson1/rooms/'+$room+'/state').child('round').val() === $round && root.child('lesson1/rooms/'+$room+'/state').child('phase').val() === 'explanation'",
              ".write": "auth != null && root.child('lesson1/rooms/'+$room+'/state').child('round').val() === $round && newData.exists()",
              ".validate": "newData.isString() && newData.val().length <= 4000"
            }
          }
        }
      }
    }
  }
}
